  "comments": {
    "overrides": "Security patches for transitive deps whose parents pin vulnerable versions. npm audit fix would otherwise downgrade Prisma 7->6 and Next 16->9. @hono/node-server: GHSA-92pp-h63x-v22m (via prisma/@prisma/dev, dev tooling). postcss: GHSA-qx2v-qp2m-jg93 (bundled by next). deepmerge-ts/mysql2: Prisma CLI transitives — override instead of prisma@6."
  },
  "overrides": {
    "@hono/node-server": "~1.19.15",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.11",
    "sharp": "^0.35.0",
