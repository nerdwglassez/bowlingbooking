{
  "name": "royalz-lanes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "drift": "node scripts/drift-check.mjs",
    "audit": "node scripts/security-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npx tsc --noEmit && npm run lint && npm run drift && npm run audit && npm test"
  },
