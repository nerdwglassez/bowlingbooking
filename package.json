{
  "name": "royalz-lanes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "drift": "node scripts/drift-check.mjs",
    "audit": "node scripts/security-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npx tsc --noEmit && npm run lint && npm run drift && npm run audit && npm test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.70.0",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.31.0",
    "dotenv": "^17.2.3",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "prisma": "7.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.42",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "comments": {
    "overrides": "Security patches for transitive deps whose parents pin vulnerable versions. npm audit fix would otherwise downgrade Prisma 7->6 and Next 16->9. @hono/node-server: GHSA-92pp-h63x-v22m (via prisma/@prisma/dev, dev tooling). postcss: GHSA-qx2v-qp2m-jg93 (bundled by next)."
  },
  "overrides": {
    "@hono/node-server": "~1.19.13",
    "postcss": "^8.5.10"
  }
}
