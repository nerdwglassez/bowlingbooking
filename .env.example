# Copy to `.env.local` and fill in secrets. Never commit real secrets.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Single-tenant launch: slug of the row in `Tenant` (see `prisma/seed.ts`).
DEFAULT_TENANT_SLUG="royalz"

# Root `/` redirect: book (default) | staff | admin. Override in src/app/page.tsx
# with PAGE_HOME_ENTRY without restarting if you prefer a file toggle.
NEXT_PUBLIC_HOME_ENTRY="book"

# Auth.js / NextAuth — generate with `npx auth secret` (or any strong random string).
# AUTH_SECRET is the canonical name; NEXTAUTH_SECRET is read as a fallback.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Seed credentials. Read by `prisma/seed.ts` ONLY — never by the running app.
# Override these in any shared environment before running `npx prisma db seed`.
SEED_ADMIN_EMAIL="admin@royalz.local"
SEED_ADMIN_PASSWORD=

# Stripe — get keys from https://dashboard.stripe.com/test/apikeys.
# Without STRIPE_SECRET_KEY the helpers in src/lib/stripe.ts return mock
# objects and the webhook handler short-circuits. Production requires real
# values.
STRIPE_SECRET_KEY=
# Publishable key is exposed to the browser by the Stripe Elements form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. For local dev, run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and paste the printed whsec_… here.
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys. Without RESEND_API_KEY the booking
# confirmation email is logged to the server console instead of dispatched.
RESEND_API_KEY=
# Optional override for the From address. Defaults to "Royal Z Lanes
# <bookings@royalz.local>". Must be a verified Resend sender for production.
RESEND_FROM_EMAIL=

# Public app URL. Used to construct webhook URLs and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sentry — error monitoring. Without NEXT_PUBLIC_SENTRY_DSN the
# observability wrapper in src/lib/observability.ts becomes a console-logging
# no-op (production emits a one-shot warning). Get the DSN at
# https://sentry.io/settings/projects/<project>/keys/. The DSN itself is safe
# to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only. Used by withSentryConfig in next.config.ts for source-map
# upload. Set in CI; leave blank locally. Generate at
# https://sentry.io/settings/account/api/auth-tokens/ with the
# project:releases scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Production performance traces (0–1). Unset = 0.1 in production, 0 elsewhere.
SENTRY_TRACES_SAMPLE_RATE=

# In-app rate limits (backstop). Production: on by default. Local: set RATE_LIMIT_ENABLED=true to test.
# RATE_LIMIT_ENABLED=
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_FIND_BOOKING_MAX=30
# RATE_LIMIT_BOOKING_ICS_MAX=20
# RATE_LIMIT_PROMO_VALIDATE_MAX=40
