// Money fields: stored as integer cents.
// $45.00 = 4500. Stripe API uses cents natively, no boundary conversion.
// Decision recorded in .claude/STACK_BASELINE.md § 4.

// ============================================================
// schema.prisma — Royal Z Lanes database schema
// See .claude/BOOKING_DOMAIN.md for full model documentation
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

// BookingStatus values:
//   HOLD            — DEPRECATED. Holds live in BookingHold.
//   CONFIRMED       — payment captured, lanes reserved
//   PENDING_PAYMENT — CODE_REQUIRED + PAYMENT_OFFLINE (Migration 4)
//   CANCELLED       — booking cancelled, refund may be pending or settled
//   COMPLETED       — booking start/end times have passed
//   NO_SHOW         — staff marked as no-show
enum BookingStatus {
  HOLD
  CONFIRMED
  PENDING_PAYMENT
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RefundStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
}

enum PartyType {
  OPEN
  BIRTHDAY
  CORPORATE
  COSMIC
}

enum CancellationReason {
  CUSTOMER_REQUEST
  NO_SHOW
  VENUE_ISSUE
  SYSTEM_EXPIRED
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

// ── Models ─────────────────────────────────────────────────

model Tenant {
  id                      String           @id @default(cuid())
  name                    String
  slug                    String           @unique
  address                 String
  phone                   String
  timezone                String           @default("America/New_York")
  themeSlug               String           @default("default") @map("theme_slug")
  holdTimeoutMins         Int              @default(10) @map("hold_timeout_mins")
  maxOnlineBowlers        Int              @default(18) @map("max_online_bowlers")
  cancellationWindowHours Int              @default(24) @map("cancellation_window_hours")
  rescheduleWindowHours   Int              @default(24) @map("reschedule_window_hours")
  checkInWindowMinutes    Int              @default(60) @map("check_in_window_minutes")
  bowlersPerLane          Int              @default(6) @map("bowlers_per_lane")
  cancellationRefundPercent Int            @default(100) @map("cancellation_refund_percent")
  config                  Json             @default("{}")
  createdAt               DateTime         @default(now()) @map("created_at")
  bookings                Booking[]
  bookingHolds            BookingHold[]
  packages                Package[]
  lanes                   Lane[]
  users                   User[]
  operatingHours          OperatingHours[]
  blockedSlots            BlockedSlot[]
  promoCodes              PromoCode[]
  pricingPeriods          PricingPeriod[]
  claimTokens             ClaimToken[]
  stripeConnectAccountId  String?          @map("stripe_connect_account_id")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?   @map("tenant_id")
  email        String    @unique
  name         String?
  phone        String?
  role         Role      @default(CUSTOMER)
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  bookings     Booking[]
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  auditLogs    AuditLog[] @relation("AuditLogUser")
  refundsIssued Payment[] @relation("PaymentRefundedBy")
  passwordResetTokens PasswordResetToken[]
  teamInviteTokens    TeamInviteToken[]      @relation("TeamInviteUser")
  teamInvitesSent     TeamInviteToken[]      @relation("TeamInviteInvitedBy")
}

model TeamInviteToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  invitedByUserId String    @map("invited_by_user_id")
  tokenHash       String    @unique @map("token_hash")
  personalMessage String?   @map("personal_message")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation("TeamInviteUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy       User      @relation("TeamInviteInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([userId])
  @@map("TeamInviteToken")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PasswordResetToken")
}

model Booking {
  id                              String              @id @default(cuid())
  tenantId                        String              @map("tenant_id")
  userId                          String?             @map("user_id")
  confirmationCode                String              @unique @map("confirmation_code")
  partyType                       PartyType           @map("party_type")
  bowlerCount                     Int                 @map("bowler_count")
  laneCount                       Int                 @map("lane_count")
  startTime                       DateTime            @map("start_time")
  endTime                         DateTime            @map("end_time")
  packageId                       String              @map("package_id")
  status                          BookingStatus       @default(HOLD)
  source                          BookingSource       @default(ONLINE)
  customerName                    String              @map("customer_name")
  customerEmail                   String              @map("customer_email")
  customerPhone                   String?             @map("customer_phone")
  totalAmount                     Int                 @map("total_amount")
  discountAmount                  Int                 @default(0) @map("discount_amount")
  promoCodeId                     String?             @map("promo_code_id")
  notes                           String?
  isRefunded                      Boolean             @default(false) @map("is_refunded")
  cancellationWindowHoursSnapshot Int?                @map("cancellation_window_hours_snapshot")
  rescheduleWindowHoursSnapshot   Int?                @map("reschedule_window_hours_snapshot")
  bowlersPerLaneSnapshot          Int?                @map("bowlers_per_lane_snapshot")
  cancellationRefundPercentSnapshot Int?              @map("cancellation_refund_percent_snapshot")
  smsReminderConsent              Boolean             @default(false) @map("sms_reminder_consent")
  marketingConsent                Boolean             @default(false) @map("marketing_consent")
  selectedAddonIds                Json                @default("[]") @map("selected_addon_ids")
  cancellationReason              CancellationReason? @map("cancellation_reason")
  checkedInAt                     DateTime?           @map("checked_in_at")
  createdAt                       DateTime            @default(now()) @map("created_at")
  updatedAt                       DateTime            @updatedAt @map("updated_at")
  tenant                          Tenant              @relation(fields: [tenantId], references: [id])
  user                            User?               @relation(fields: [userId], references: [id])
  package                         Package             @relation(fields: [packageId], references: [id])
  promoCode                       PromoCode?          @relation(fields: [promoCodeId], references: [id])
  lanes                           BookingLane[]
  bowlers                         BookingBowler[]
  payment                         Payment?
  auditLogs                       AuditLog[]
  claimToken                      ClaimToken?

  @@index([tenantId, status, startTime])
}

model BookingBowler {
  bookingId String  @map("booking_id")
  index     Int
  shoeSize  String? @map("shoe_size")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([bookingId, index])
}

model Package {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  name          String
  description   String?
  basePrice     Int         @map("base_price")
  gameIncluded  Boolean     @default(false) @map("game_included")
  shoesIncluded Boolean     @default(false) @map("shoes_included")
  gameCostPer   Int?        @map("game_cost_per")
  shoeCostPer   Int?        @map("shoe_cost_per")
  partyTypes    PartyType[]
  inclusions    Json        @default("[]")
  accessType    String      @default("PUBLIC") @map("access_type")
  pricingType   String?     @map("pricing_type")
  codeString    String?     @map("code_string")
  discountType  String?     @map("discount_type")
  discountValue Int?        @map("discount_value")
  expiresAt     DateTime?   @map("expires_at")
  usageLimit    Int?        @map("usage_limit")
  usageCount    Int         @default(0) @map("usage_count")
  paymentMode   String?     @map("payment_mode")
  active        Boolean     @default(true)
  sortOrder     Int         @default(0) @map("sort_order")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  bookings      Booking[]

  @@unique([tenantId, codeString])
}

model Payment {
  id                    String       @id @default(cuid())
  bookingId             String       @unique @map("booking_id")
  stripePaymentIntentId String?      @unique @map("stripe_payment_intent_id")
  amount                Int
  // Stripe PaymentIntent status OR walk-in method label (cash, card_at_counter).
  status                String
  paymentMethod         String?      @map("payment_method")
  stripeRefundId        String?      @map("stripe_refund_id")
  refundAmount          Int?         @map("refund_amount")
  refundStatus          RefundStatus @default(NONE) @map("refund_status")
  refundReason          String?      @map("refund_reason")
  refundedAt            DateTime?    @map("refunded_at")
  refundedBy            String?      @map("refunded_by")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  booking               Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refundedByUser        User?        @relation("PaymentRefundedBy", fields: [refundedBy], references: [id])
}

model Lane {
  id       String        @id @default(cuid())
  tenantId String        @map("tenant_id")
  number   Int
  active   Boolean       @default(true)
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  bookings BookingLane[]

  @@unique([tenantId, number])
}

model BookingLane {
  bookingId String  @map("booking_id")
  laneId    String  @map("lane_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lane      Lane    @relation(fields: [laneId], references: [id])

  @@id([bookingId, laneId])
}

model OperatingHours {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  dayOfWeek Int    @map("day_of_week")
  openTime  String @map("open_time")
  closeTime String @map("close_time")
  closed    Boolean @default(false)
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dayOfWeek])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?
  lanes     Int[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startTime, endTime])
}

model AuditLog {
  id         String   @id @default(cuid())
  bookingId  String?  @map("booking_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking? @relation(fields: [bookingId], references: [id])
  user       User?    @relation("AuditLogUser", fields: [userId], references: [id])
}

model BookingHold {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  bowlerCount  Int      @map("bowler_count")
  laneCount    Int      @map("lane_count")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startTime, endTime])
  @@index([expiresAt])
}

model StripeEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([type])
}

model PromoCode {
  id            String            @id @default(cuid())
  tenantId      String            @map("tenant_id")
  code          String
  description   String?
  discountType  PromoDiscountType @map("discount_type")
  discountValue Int               @map("discount_value")
  maxUses       Int?              @map("max_uses")
  usesCount     Int               @default(0) @map("uses_count")
  expiresAt     DateTime?         @map("expires_at")
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  bookings Booking[]

  @@unique([tenantId, code])
  @@map("promo_codes")
}

model PricingPeriod {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  name                 String
  ratePerPersonPerHour Int      @map("rate_per_person_per_hour")
  daysOfWeek           Int[]    @map("days_of_week")
  startTime            String?  @map("start_time")
  endTime              String?  @map("end_time")
  specificDates        DateTime[] @map("specific_dates")
  priority             Int      @default(0)
  tenant               Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, priority])
}

model ClaimToken {
  id        String    @id @default(cuid())
  bookingId String    @unique @map("booking_id")
  tenantId  String    @map("tenant_id")
  email     String
  token     String    @unique @default(cuid())
  expiresAt DateTime  @map("expires_at")
  claimedAt DateTime? @map("claimed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([token])
}
