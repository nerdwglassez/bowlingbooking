// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  CHECKED_IN
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  sessions     Session[]
  bookings     Booking[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model OperatingHours {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 6 = Saturday
  openTime  String?  @map("open_time") // "09:00" format
  closeTime String?  @map("close_time") // "22:00" format
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("operating_hours")
}

model LaneBlock {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String   @map("start_time") // "14:00" format
  endTime   String   @map("end_time") // "16:00" format
  lanes     String   @map("lanes") // JSON array: ["1", "2", "3"]
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") // User ID

  @@index([date])
  @@map("lane_blocks")
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  type        String   // "FOOD", "PARTY", "DRINK"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookingPackages BookingPackage[]

  @@map("packages")
}

model Booking {
  id          String        @id @default(cuid())
  userId       String        @map("user_id")
  date         DateTime      @db.Date
  startTime    String        @map("start_time") // "14:00" format
  duration     Int           // Duration in minutes (60, 90, 120, etc.)
  lane         Int           // Lane number (1-20)
  numBowlers   Int           @map("num_bowlers")
  shoeSizes    String?       @map("shoe_sizes") // JSON array: ["8", "9", "10"]
  status       BookingStatus @default(PENDING)
  totalPrice   Decimal       @map("total_price") @db.Decimal(10, 2)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  bookingPackages BookingPackage[]
  payments     Payment[]

  @@index([userId])
  @@index([date])
  @@index([date, startTime])
  @@map("bookings")
}

model BookingPackage {
  id        String   @id @default(cuid())
  bookingId String  @map("booking_id")
  packageId String  @map("package_id")
  quantity  Int      @default(1)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@index([bookingId])
  @@index([packageId])
  @@map("booking_packages")
}

model Payment {
  id                    String   @id @default(cuid())
  bookingId             String   @map("booking_id")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  amount                Decimal  @db.Decimal(10, 2)
  status                String   // "pending", "succeeded", "failed", "refunded"
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

model Settings {
  id                    String   @id @default(cuid())
  key                   String   @unique
  value                 String   // JSON string for complex values
  description           String?  // Human-readable description
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("settings")
}


