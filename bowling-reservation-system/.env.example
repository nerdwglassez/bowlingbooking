# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT (test & debug)
# Copy to .env.local and use ONLY for local work. Never put production
# DATABASE_URL or production secrets here. See docs/LOCAL_VS_LIVE.md.
# ---------------------------------------------------------------------------

# Database – local Postgres only (run: npm run db:local:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bowling"

# App (local URLs)
NODE_ENV="development"
NEXTAUTH_SECRET="generate-a-random-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-secret-here-min-32-chars"

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email – Resend (optional)
RESEND_API_KEY=""
EMAIL_FROM="noreply@localhost"

# Mailchimp (optional)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=
