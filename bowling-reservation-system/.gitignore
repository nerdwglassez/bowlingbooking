/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# local env files (never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# vercel
.vercel

# typescript (keep next-env.d.ts tracked — Next.js + tsconfig expect it)
*.tsbuildinfo

# prisma: generated client (output path in schema.prisma)
/generated

# caches & local tooling
.eslintcache
.turbo

# IDE / OS
.idea/
Thumbs.db

# optional local tooling secrets
.env.sentry-build-plugin
